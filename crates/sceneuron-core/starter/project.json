  "conditions": [
    {
      "id": "showing-item",
      "name": "Showing something",
      "prompt": "The person is deliberately holding an object up toward the camera to show it to viewers.",
      "detail": "the object's name in one to four words, such as \"coffee mug\"",
      "enabled": true,
      "min_confidence": 0.6,
      "confirm": 1,
      "release": 2
    },
    {
      "id": "pet-in-view",
      "name": "Pet on camera",
      "prompt": "A cat, dog, or other pet animal is clearly visible in the image.",
      "detail": "the kind of animal as one capitalized word, such as \"Cat\"",
      "enabled": true,
      "min_confidence": 0.6,
      "confirm": 1,
      "release": 2
    }
  ],
  "rules": [
    {
      "id": "away-show-brb",
      "name": "Show BRB when I leave",
      "enabled": true,
      "when": "away",
      "actions": [
        {
          "type": "set_props",
          "element": "brb",
          "props": {
            "visible": true
          }
        }
      ]
    },
    {
      "id": "present-hide-brb",
      "name": "Hide BRB when I return",
      "enabled": true,
      "when": "present",
      "actions": [
        {
          "type": "set_props",
          "element": "brb",
          "props": {
            "visible": false
          }
        },
        {
          "type": "effect",
          "element": "cam-frame",
          "effect": "flash"
        }
      ]
    },
    {
      "id": "item-show",
      "name": "Name what I hold up",
      "enabled": true,
      "when": {
        "condition": "showing-item",
        "state": "on"
      },
      "actions": [
        {
          "type": "set_props",
          "element": "now-showing",
          "props": {
            "visible": true
          }
        }
      ]
    },
    {
      "id": "item-hide",
      "name": "Hide it when I put it down",
      "enabled": true,
      "when": {
        "condition": "showing-item",
        "state": "off"
      },
      "actions": [
        {
          "type": "set_props",
          "element": "now-showing",
          "props": {
            "visible": false
          }
        }
      ]
    },
    {
      "id": "pet-show",
      "name": "Announce my pet",
      "enabled": true,
      "when": {
        "condition": "pet-in-view",
        "state": "on"
      },
      "actions": [
        {
          "type": "set_props",
          "element": "pet-alert",
          "props": {
            "visible": true
          }
        },
        {
          "type": "effect",
          "element": "cam-frame",
          "effect": "bounce"
        }
      ]
    },
    {
      "id": "pet-hide",
      "name": "Hide the pet alert",
      "enabled": true,
      "when": {
        "condition": "pet-in-view",
        "state": "off"
      },
      "actions": [
        {
          "type": "set_props",
          "element": "pet-alert",
          "props": {
            "visible": false
          }
        }
      ]
    }
  ],
