{
  "name": "sceneuron-streamdeck",
  "version": "0.4.0",
  "private": true,
  "description": "Stream Deck plugin that raises Sceneuron cards, plays its reactions, and shows or hides its overlays",
  "license": "UNLICENSED",
  "author": "Alexander Picon, Chaski AI (https://chaski.ai)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c",
    "check": "tsc --noEmit",
    "test": "rollup -c --silent && node --test \"tests/**/*.test.mjs\"",
    "validate": "streamdeck validate ai.chaski.sceneuron.sdPlugin --no-update-check",
    "package": "rollup -c --silent && streamdeck pack ai.chaski.sceneuron.sdPlugin -o dist -f --no-update-check",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart ai.chaski.sceneuron\""
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "24.19.0",
    "rollup": "4.63.5",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  }
}
